	local function doPunch()
		if State.isPunching or not punchUnlocked or os.clock() < punchCdEnd then return end
		stopEmote()
		State.isPunching = true; setOverlay(punchUI, true)
		stopAllMovement(); State.currentMovementAnim = nil
		if State.isBlocking then State.isBlocking = false; tracks.Block:Stop(0.1) end
		tracks.Punch:Play(0.1)
		task.delay(LUNGE_TIME, function()
			if State.isPunching and character.Parent then
				local bv = Instance.new("BodyVelocity", rootPart)
				bv.Velocity, bv.MaxForce, bv.P = rootPart.CFrame.LookVector * (LUNGE_STUDS / LUNGE_DURATION), Vector3.new(1e5, 0, 1e5), 1e5
				Debris:AddItem(bv, LUNGE_DURATION)
			end
		end)
		tracks.Punch.Stopped:Wait()
		State.isPunching = false
		if not character.Parent then return end
		punchUnlocked, State.currentMovementAnim = false, nil
		setPunchLocked(true); applySlowFor(PUNCH_SLOW_DURATION)
		punchCdEnd = os.clock() + PUNCH_CD
		task.delay(PUNCH_CD, function() if character.Parent and not State.isPunching then setOverlay(punchUI, false) end end)
	end

	local function handleBlockInput()
		if State.isPunching or os.clock() < blockCdEnd then return end
		stopEmote(); State.isBlocking = true
		tracks.Block:Play(0.15)
		blockCdEnd = os.clock() + BLOCK_CD
		if not punchUnlocked then punchUnlocked = true; setPunchLocked(false) end
		applySlowFor(BLOCK_SLOW_DURATION)
		task.delay(BLOCK_DURATION, function()
			if character.Parent and State.isBlocking then State.isBlocking = false; tracks.Block:Stop(0.3) end
		end)
	end

