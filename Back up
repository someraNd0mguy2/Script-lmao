		if moving and State.isEmoting and not State.isMovingEmote then stopEmote() end
		
		if not State.isPunching and not State.isEmoting then
			local targetAnim = moving and (State.isSprinting and tracks.Run or (isInjured and tracks.InjuredWalk or tracks.Walk)) or (isInjured and tracks.InjuredIdle or tracks.Idle)
			playMovementAnim(targetAnim)
		elseif State.isEmoting or State.isPunching then
			stopAllMovement(); State.currentMovementAnim = nil
		end

		local targetFov = (State.isSprinting and moving) and 85 or 70
		camera.FieldOfView = camera.FieldOfView + (targetFov - camera.FieldOfView) * math.min(dt * 2, 1)

		if State.isShiftLock then
			humanoid.AutoRotate = false
			local camLook = camera.CFrame.LookVector
			rootPart.CFrame = rootPart.CFrame:Lerp(CFrame.lookAt(rootPart.Position, rootPart.Position + Vector3.new(camLook.X, 0, camLook.Z)), 0.5)
		else
			humanoid.AutoRotate = true
			-- Removed 'not State.isMovingEmote' so WASD/Joystick can naturally steer the character
			if moving then
				rootPart.CFrame = rootPart.CFrame:Lerp(CFrame.lookAt(rootPart.Position, rootPart.Position + humanoid.MoveDirection), 0.1)
			end
		end
        
		-- Deleted: 'if State.isMovingEmote then humanoid:Move(rootPart.CFrame.LookVector) end'
    -- Removing that line stops the script from acting like cruise-control, allowing you to stop and move freely.

		-- Handle Head Rotation Track based on Injured State or Emoting
		if isInjured or State.isEmoting then
			if tracks.Head.IsPlaying then
				tracks.Head:Stop(0.1)
			end
		else
			if not tracks.Head.IsPlaying then
				tracks.Head:Play(0.1, 1, 0)
				tracks.Head:AdjustWeight(0.5)
			end
		end

		local targetYaw = 0
		if not (State.isPunching or State.isEmoting or isInjured) then
			local camDirObjSpace = rootPart.CFrame:VectorToObjectSpace(camera.CFrame.LookVector)
			local rawYaw = -math.atan2(camDirObjSpace.X, -camDirObjSpace.Z)
			local absYaw = math.abs(rawYaw)
	
			-- Look straight forward (0) if camera is directly behind (<= 35 deg) 
			-- OR if camera is directly in front (>= 170 deg, which is 180 minus 10, note this is optional so its your choice)
			if absYaw <= math.rad(35) or absYaw >= math.rad(170) then
				targetYaw = 0
			else
				targetYaw = math.clamp(rawYaw, -math.rad(65), math.rad(65))
			end
		end
	
		if not isInjured and not State.isEmoting then
			currentYaw = currentYaw + (targetYaw - currentYaw) * math.min(dt * smoothness, 1)
			local yawMapped = (currentYaw < 0 and currentYaw + (math.pi * 2) or currentYaw)
			if tracks.Head.Length > 0 then tracks.Head.TimePosition = (yawMapped / (math.pi * 2)) * tracks.Head.Length end
		end

		local now = os.clock()
		if now < punchCdEnd and not State.isPunching then setOverlay(punchUI, true, tostring(math.ceil(punchCdEnd - now))) end
		if State.isBlocking then setOverlay(blockUI, true)
		elseif now < blockCdEnd then setOverlay(blockUI, true, string.format("%.2f", blockCdEnd - now))
		else setOverlay(blockUI, false) end
	end))

	local isInjured = State.forceInjured or (humanoid.Health <= INJURED_HEALTH_THRESHOLD)
	local initialIdle = isInjured and tracks.InjuredIdle or tracks.Idle
	local style = ANIM_STYLES[currentStyleIndex]
	
	initialIdle:Play(0)
	if isInjured then
		initialIdle:AdjustSpeed(style.InjuredIdleAnimSpeed or 1)
	else
		initialIdle:AdjustSpeed(style.IdleAnimSpeed or 1)
	end

	State.currentMovementAnim = initialIdle
end

-- Calling this function ensures the music starts exactly when the script loads
playNextInPlaylist()

-- Reset still works :]
player.CharacterAdded:Connect(setupCharacter)
if player.Character then setupCharacter(player.Character) end
