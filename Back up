			autoMoveConnection = nil
		end
	end

local function startAutoMove(isMoveable)
	if not humanoid or not rootPart then return end
	
	stopAutoMove() 
	
	-- Safely attempt to hook into Roblox's PlayerModule to read raw Joystick/WASD input
	local controls = nil
	pcall(function()
		local PlayerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		controls = PlayerModule:GetControls()
	end)
	
	autoMoveConnection = game:GetService("RunService").RenderStepped:Connect(function()
		if humanoid.Health > 0 then
			
			-- If Moveable is set to true in the emote data, allow steering
			if isMoveable then
				local turnDir = Vector3.new(0, 0, 0)
				
				if controls then
					-- Method A: Use PlayerModule (Best for Joystick & Mobile)
					local moveVec = controls:GetMoveVector()
					if moveVec.Magnitude > 0 then
						turnDir = workspace.CurrentCamera.CFrame:VectorToWorldSpace(moveVec)
						turnDir = Vector3.new(turnDir.X, 0, turnDir.Z).Unit
					end
				else
					-- Method B: Fallback to reading MoveDirection before it gets overwritten
					local inputDir = humanoid.MoveDirection
					if inputDir.Magnitude > 0.1 then
						turnDir = inputDir
					end
				end
				
				-- Apply the rotation smoothly if the player is trying to turn
				if turnDir.Magnitude > 0 then
					rootPart.CFrame = rootPart.CFrame:Lerp(CFrame.lookAt(rootPart.Position, rootPart.Position + turnDir), 0.1)
				end
			end
			
			-- Continually push the character forward in whatever direction they are now facing
			humanoid:Move(rootPart.CFrame.LookVector, false)
		else
			stopAutoMove()
		end
	end)
end

