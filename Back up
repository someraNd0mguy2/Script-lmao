-- ### Audio System Supporter ###
local function getCustomAudio(soundData)
    if not soundData or not soundData.Url or not soundData.FileName then return nil end
    
    local folder = "CustomEmoteSounds"
    if not isfolder(folder) then makefolder(folder) end
    
    local path = folder .. "/" .. soundData.FileName
    if not isfile(path) then
        local success, result = pcall(function() return game:HttpGet(soundData.Url) end)
        if success then 
            writefile(path, result) 
        else 
            warn("Failed to download: " .. soundData.Url)
            return nil 
        end
    end
    
    return getcustomasset(path)
end

