-- 2. Fixed helper function to download and cache GitHub .mp3 files
local function resolveAudioId(audioPath)
    -- If it's a web URL pointing to an mp3
    if string.match(audioPath, "^http.*%.mp3$") or string.match(audioPath, "%.mp3$") then
        -- Extract just the file name from the URL so we can save it cleanly
        local fileName = "custom_bgm_" .. string.match(audioPath, "([^/]+)$") 
        
        -- Only download it if we haven't already saved it to the executor's workspace
        if not isfile(fileName) then
            local audioData = game:HttpGet(audioPath)
            writefile(fileName, audioData)
        end
        
        -- Return the local custom asset path
        return getcustomasset(fileName)
        
    -- If it's just numbers, format it as a roblox asset
    elseif tonumber(audioPath) then
        return "rbxassetid://" .. tostring(audioPath)
        
    -- If it already has rbxassetid://, just return it
    else
        return audioPath
    end
end

-- 3. Function now safely accesses pre-defined variables
local function playNextInPlaylist()
    if currentTrackIndex > #playlistKeys then 
        currentTrackIndex = 1 
    end

    local songName = playlistKeys[currentTrackIndex]

    bgmPlayer.SoundId = resolveAudioId(soundtracks[songName])
    bgmPlayer.Looped = false 
    bgmPlayer:Play()

    if playlistConnection then 
        playlistConnection:Disconnect() 
    end

    playlistConnection = bgmPlayer.Ended:Connect(function()
        currentTrackIndex = currentTrackIndex + 1
        playNextInPlaylist()
    end)
end



