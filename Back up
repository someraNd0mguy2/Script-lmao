                local a = Instance.new("Animation")
                a.AnimationId = v
                table.insert(animsToPreload, a)
            end
        end
    end
    
    if #animsToPreload > 0 then
        pcall(function()
            ContentProvider:PreloadAsync(animsToPreload)
        end)
    end
end)

-- ### Robust Track Loader Helper ###
local function loadTrack(animator, assetId, looped, priority)
    -- Handle missing or dummy placeholder IDs safely
    if not assetId or assetId == "" or assetId == "rbxassetid://0000000000" then 
        return nil 
    end

    local anim = Instance.new("Animation")
    anim.AnimationId = assetId

    -- Ensure asset data is ready before loading into Animator
    pcall(function()
        ContentProvider:PreloadAsync({ anim })
    end)

    local success, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)

    if success and track then
        track.Looped = looped or false
        if priority then 
            track.Priority = priority 
        end
        return track
    else
        warn("[Animation System] Failed to load animation track: " .. tostring(assetId))
        return nil
    end
end



