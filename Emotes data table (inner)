-- Emotes Configurations, I guess?-
--[[ 
   Name = "Whatever you put in here"  -- The name of the emote,

   ID = "rbxassetid://YourAnimID",  -- Put the ID of the anim or emote you want here, use a logger or smt to get it,

   WalkSpeed = number  -- Character movement speed while emoting,

   AnimSpeed = number   -- The animation itself speed),

   IsLooping = true / false  --Means it will loop the animation and the music aswell,

   IsMovingEmote = true  -- Means that you can move while using the emote,

	 CustomSound = {
    FileName = "YourMusicThatYouCanName.mp3",  -- Name whatever you like
		Url = "TheLinkFile.Mp3ThatYouPutInHere" }  -- The raw link of your file in github,

    HeightOffset = number  -- The offert your character you want to set higher or lower (Mostly useless ngl),

    -- this config, I will probably fix it
    Phase2Start = number,  -- The exact second you want the part to speed up (you'll need to align this)
    Phase2Speed = number  -- How fast you want the 2nd part to play,

	  SequenceType = "AnimsLooped/Intro", -- Tells the handler to use that Type of Sequence.
    Sequence = {
		  { ID = "rbxassetid://102806201875589", Duration = 0.5 }, -- first anim plays
		  { ID = "rbxassetid://106544616318711", Duration = 0.5 }, -- second anim plays
		  { ID = "rbxassetid://127080445177635", Duration = 0.5 }, -- third anim plays
		  { ID = "rbxassetid://72037992741389",  Duration = 0.3 }  -- This last anim (or track) will loop / Will loop back the whole anim thing (You can add more Phase if you want)
     }

		  Moveable = true / false  -- If true then it allows the player to turn freely using their movement on devices without needing shiftlock (false is just not letting them turn freely with default movement)

		  AutoMove = true / false  -- the emote will move on it owns if its true (false will stay in place and the user is required to move)


    -- By only having these two will result in a 1 time anim played.
    Name = "Whatever you put in here"
    ID = "rbxassetid://YourAnimID"
]]
